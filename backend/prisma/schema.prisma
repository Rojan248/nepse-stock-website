// Prisma schema for NEPSE backend (SQLite for local dev)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Stock {
  id             Int      @id @default(autoincrement())
  symbol         String   @unique
  companyName    String
  sector         String?
  lastTradedPrice Float?
  previousClose   Float?
  openPrice       Float?
  highPrice       Float?
  lowPrice        Float?
  volume          Float?
  totalTrades     Int?
  turnover        Float?
  change          Float?
  percentageChange Float?
  updatedAt      DateTime @default(now()) @updatedAt

  history        MarketHistory[]

  @@index([sector])
}

model MarketHistory {
  id          Int      @id @default(autoincrement())
  symbol      String
  date        DateTime
  closePrice  Float?
  highPrice   Float?
  lowPrice    Float?
  volume      Float?
  turnover    Float?
  change      Float?
  percentageChange Float?

  stock       Stock?   @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@index([symbol, date])
}

model MarketSummary {
  id                Int      @id @default(autoincrement())
  indexValue        Float?
  indexChange       Float?
  indexChangePercent Float?
  totalTurnover     Float?
  totalVolume       Float?
  totalTransactions Float?
  activeCompanies   Int?
  advancedCompanies Int?
  declinedCompanies Int?
  unchangedCompanies Int?
  timestamp         DateTime @default(now())
}

model SectorIndex {
  id              Int      @id @default(autoincrement())
  topic           String   // e.g., "Banking", "NEPSE Index"
  indexValue      Float
  change          Float
  percentageChange Float
  timestamp       DateTime @default(now())
}

model Ipo {
  id          Int      @id @default(autoincrement())
  symbol      String   @unique
  companyName String
  sector      String?
  issueDate   DateTime?
  closingDate DateTime?
  price       Float?
  units       Int?
  status      String?
  issueManager String?
}

// ==================== Auth & User Models ====================

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  passwordHash  String
  displayName   String?
  role          String    @default("user") // "user" | "admin"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  refreshTokens RefreshToken[]
  watchlists    Watchlist[]
  portfolios    Portfolio[]
  alerts        Alert[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==================== Watchlist Models ====================

model Watchlist {
  id         Int       @id @default(autoincrement())
  name       String
  userId     Int
  publicSlug String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      WatchlistItem[]

  @@index([userId])
}

model WatchlistItem {
  id          Int      @id @default(autoincrement())
  watchlistId Int
  symbol      String
  addedAt     DateTime @default(now())

  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbol])
}

// ==================== Portfolio Models ====================

model Portfolio {
  id        Int      @id @default(autoincrement())
  name      String
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades    Trade[]

  @@index([userId])
}

model Trade {
  id          Int      @id @default(autoincrement())
  portfolioId Int
  symbol      String
  type        String   // "buy" | "sell"
  quantity    Int
  price       Float
  date        DateTime
  note        String?
  createdAt   DateTime @default(now())

  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([symbol])
}

// ==================== Alert Models ====================

model Alert {
  id         Int       @id @default(autoincrement())
  userId     Int
  symbol     String
  condition  String    // "above" | "below" | "pct_change"
  threshold  Float
  enabled    Boolean   @default(true)
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries AlertDelivery[]

  @@index([userId])
  @@index([symbol])
}

model AlertDelivery {
  id          Int      @id @default(autoincrement())
  alertId     Int
  triggeredAt DateTime @default(now())
  priceAtTrigger Float
  channel     String   // "in-app" | "email" | "webhook"

  alert       Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId])
}

// ==================== AI & Metrics Models ====================

model StockMetrics {
  id               Int      @id @default(autoincrement())
  symbol           String
  date             DateTime
  priceMetrics     String?  // JSON: 52wHigh, 52wLow, atCircuitHigh, atCircuitLow, consecutiveUp, consecutiveDown
  trendMetrics     String?  // JSON: ma20, ma50, ma180, goldenCross, deathCross
  momentumMetrics  String?  // JSON: rsi14, rsi7, roc10d, roc30d
  liquidityMetrics String?  // JSON: avgVolume20d, volumeRatio, turnoverRatio, liquidityScore, isVolumeSpike
  relativeMetrics  String?  // JSON: vsSectorAvg, sectorRank, marketRank
  fundamentals     String?  // JSON: basePrice, priceToBase, sector
  patterns         String?  // JSON: composite flags derived from all metrics
  signals          String?  // JSON: array of signal objects [{type, label, sentiment}]
  computedAt       DateTime @default(now())

  @@unique([symbol, date])
  @@index([symbol])
}

model AIOverview {
  id           Int      @id @default(autoincrement())
  symbol       String
  type         String   @default("stock") // "stock" | "market"
  context      String?  // JSON: fact sheet / input data snapshot
  narrative    String?  // JSON: { summary, bullets, outlook, generatedAt }
  modelVersion String?
  tokenCount   Int?
  triggeredBy  String?  // "scheduler" | "manual" | "startup"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([symbol, type])
  @@index([symbol])
}
