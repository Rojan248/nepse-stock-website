# NEPSE Backend Environment Configuration

# Server
NODE_ENV=production
PORT=5000
NODE_ENV=development
DATABASE_URL="file:./prisma/dev.db"

# Data Update Settings
NEPSE_UPDATE_INTERVAL=8000
MARKET_OPEN_HOUR=10
MARKET_CLOSE_HOUR=15

# Logging
LOG_LEVEL=info

# IP Logging (GDPR/CCPA Compliance)
# Set to 'true' to log anonymized IPs in error logs
# When enabled, IPs are anonymized (last octet zeroed + hash for correlation)
# Default: not set (IPs are NOT logged)
# LOG_IPS=true
# LOG_IP_SALT=your-unique-salt-here

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000

# Security
# Key for protected Admin endpoints (/force-update, /admin/cleanup)
# Send this value in the 'x-admin-key' header
ADMIN_API_KEY=change-this-to-a-secure-random-string

# JWT Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Gemini AI (Phases 4 & 8)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACK=gemini-2.0-flash
AI_OVERVIEW_COOLDOWN_MINUTES=30

# Alerting (Optional - Discord/Slack webhook)
# WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# ALERT_ENABLED=true

# Retry/Circuit Breaker Configuration
# MAX_RETRIES=5
# RETRY_MIN_TIMEOUT=2000
# RETRY_FACTOR=2
# CIRCUIT_THRESHOLD=3
# CIRCUIT_COOLDOWN_MS=1800000
