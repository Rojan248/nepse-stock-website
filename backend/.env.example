# NEPSE backend environment template.
# Copy this file to backend/.env and fill local secrets there.

# Server
NODE_ENV=development
PORT=5000
DATABASE_URL="file:./prisma/dev.db"

# Data Update Settings
NEPSE_UPDATE_INTERVAL=8000
MARKET_OPEN_HOUR=10
MARKET_CLOSE_HOUR=15

# Logging
LOG_LEVEL=info

# IP Logging (GDPR/CCPA Compliance)
# Set to 'true' to log anonymized IPs in error logs
# When enabled, IPs are anonymized (last octet zeroed + hash for correlation)
# Default: not set (IPs are NOT logged)
# LOG_IPS=true
# LOG_IP_SALT=your-unique-salt-here

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000

# Reverse proxy trust. Keep false unless the API is behind a trusted proxy.
# Use 1 for one trusted proxy hop, or loopback/linklocal/uniquelocal for Express presets.
TRUST_PROXY=false

# Security
# Key for protected admin endpoints (/force-update, /admin/cleanup, /watchdog/verify).
# Send this value in the x-admin-key header.
ADMIN_API_KEY=

# JWT Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional AI summary scaffold.
# Disabled by default. Do not set provider/api keys until the feature is intentionally enabled.
AI_SUMMARIES_ENABLED=false
AI_SUMMARIES_PROVIDER=disabled
AI_SUMMARIES_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
AI_STOCK_BATCH_SIZE=32
AI_STOCK_MAX_OUTPUT_TOKENS=2600
AI_MARKET_MAX_OUTPUT_TOKENS=1200
AI_DAILY_BUDGET_USD=0.50
AI_REUSE_UNCHANGED_SUMMARIES=true

# Alerting (Optional - Discord/Slack webhook)
# WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# ALERT_ENABLED=true

# Retry/Circuit Breaker Configuration
# MAX_RETRIES=5
# RETRY_MIN_TIMEOUT=2000
# RETRY_FACTOR=2
# CIRCUIT_THRESHOLD=3
# CIRCUIT_COOLDOWN_MS=1800000
